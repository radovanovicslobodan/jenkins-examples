pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo "Starting the build..."
                echo "✅ Build completed successfully!"
            }
        }
    }

    post {
        success {
            echo "🎉 The build succeeded successfully!"
            // You can add real actions here like:
            // - Archive artifacts
            // - Notify team of success
            // - Trigger downstream job
        }
        failure {
            echo "🚫 This will NOT run because the build succeeded."
        }
        always {
            echo "🏁 This runs no matter what — good for cleanup tasks."
        }
    }
}
